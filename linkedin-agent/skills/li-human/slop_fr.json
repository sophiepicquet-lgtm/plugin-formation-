{
  "version": "1.0-fr",
  "note": "Lexique français utilisé par humanize.py et detect.py quand le texte est en français (détection automatique ou --lang fr). Les entrées \"flag\": true sont signalées sans être remplacées, car un remplacement automatique casserait l'accord ou le sens. Les espaces insécables et les apostrophes typographiques sont conservées : elles font partie de la typographie française. À modifier librement.",
  "invisible": [
    {"cp": "U+200B", "name": "ZERO WIDTH SPACE", "action": "delete"},
    {"cp": "U+200C", "name": "ZERO WIDTH NON-JOINER", "action": "delete"},
    {"cp": "U+200D", "name": "ZERO WIDTH JOINER", "action": "delete"},
    {"cp": "U+2060", "name": "WORD JOINER", "action": "delete"},
    {"cp": "U+FEFF", "name": "ZERO WIDTH NO-BREAK SPACE / BOM", "action": "delete"},
    {"cp": "U+00AD", "name": "SOFT HYPHEN", "action": "delete"},
    {"cp": "U+180E", "name": "MONGOLIAN VOWEL SEPARATOR", "action": "delete"},
    {"cp": "U+061C", "name": "ARABIC LETTER MARK", "action": "delete"},
    {"cp": "U+200E", "name": "LEFT-TO-RIGHT MARK", "action": "delete"},
    {"cp": "U+200F", "name": "RIGHT-TO-LEFT MARK", "action": "delete"},
    {"cp": "U+E0000-U+E007F", "name": "TAG CHARACTERS (invisible ASCII smuggling)", "action": "delete"},
    {"cp": "U+2009", "name": "THIN SPACE", "action": "space"},
    {"cp": "U+2007", "name": "FIGURE SPACE", "action": "space"},
    {"cp": "U+2003", "name": "EM SPACE", "action": "space"},
    {"cp": "U+2002", "name": "EN SPACE", "action": "space"}
  ],
  "typographic": [
    {"from": "—", "name": "EM DASH (tiret cadratin en incise)", "to": ", "},
    {"from": "–", "name": "EN DASH (tiret demi-cadratin)", "to": "-"},
    {"from": "“", "name": "GUILLEMET ANGLAIS OUVRANT", "to": "« "},
    {"from": "”", "name": "GUILLEMET ANGLAIS FERMANT", "to": " »"},
    {"from": "…", "name": "POINTS DE SUSPENSION (un seul caractère)", "to": "..."},
    {"from": "•", "name": "PUCE", "to": "-"},
    {"from": "→", "name": "FLÈCHE", "to": "->"}
  ],
  "splice_connectives": ["aussi", "donc", "bref", "au final", "finalement"],
  "words": [
