    {"find": "en constante évolution", "replace": "qui change vite", "family": "ouvertures"},
    {"find": "en perpétuelle évolution", "replace": "qui change vite", "family": "ouvertures"},
    {"find": "à l'aube de", "replace": "au début de", "family": "ouvertures"},
