    {"find": "en définitive", "replace": "au fond", "family": "clôtures"},
    {"find": "pour conclure", "replace": "pour finir", "family": "clôtures"}
  ],
  "structures": [
    {"id": "pas-seulement", "regex": "(?i)\\bce n['’]est pas (?:seulement |juste |uniquement |qu['’]une? )?[^.!?\\n]{2,60}[,.]\\s*c['’]est\\b", "name": "« Ce n'est pas (juste) X, c'est Y »", "fix": "Dites directement la chose que vous pensez. Supprimez la mise en scène."},
    {"id": "non-seulement", "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également|encore)\\b", "name": "« Non seulement X mais aussi Y »", "fix": "Faites deux phrases, ou gardez seulement la plus forte."},
    {"id": "il-ne-sagit-pas", "regex": "(?i)\\bil ne s['’]agit pas (?:de|d['’])[^.!?\\n]{2,60}[.!,]\\s*il s['’]agit (?:de|d['’])", "name": "« Il ne s'agit pas de X. Il s'agit de Y. »", "fix": "Commencez par Y. Le retournement est le tic."},
    {"id": "question-reveal", "regex": "(?im)^\\s*(?:le résultat|la suite|le secret|la clé|le problème|la vérité|le plus fou|la raison)\\s*\\?\\s*$", "name": "Ligne-question de mise en scène (« Le résultat ? »)", "fix": "Donnez la réponse dans la phrase, sans suspense."},
    {"id": "voici-ce-que", "regex": "(?i)\\bvoici ce que (?:j['’]ai|nous avons) appris\\b", "name": "« Voici ce que j'ai appris »", "fix": "Énoncez la leçon. Pas l'annonce."},
    {"id": "triade", "regex": "(?i)\\b\\w+, \\w+ et \\w+\\.", "name": "Énumération en trois temps", "fix": "Deux éléments ou quatre. Trois est le rythme par défaut des IA."},
    {"id": "fusee", "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]", "name": "Émojis fusée / feu / ampoule / étincelles / cible", "fix": "Un émoji maximum, et pas l'un de ces cinq."},
    {"id": "mur-hashtags", "regex": "(?:#\\w+[ \\t]*){5,}", "name": "Mur de hashtags (5 ou plus)", "fix": "Trois hashtags suffisent."},
    {"id": "en-tant-qu-ia", "regex": "(?i)\\ben tant qu['’](?:ia|intelligence artificielle|assistant|modèle de langage)\\b", "name": "Auto-référence de modèle", "fix": "Supprimez la phrase."},
    {"id": "en-resume", "regex": "(?im)^\\s*(?:en résumé|en conclusion|pour résumer|en somme)\\b", "name": "Conclusion de dissertation", "fix": "Un post n'a pas besoin de paragraphe de conclusion."},
    {"id": "appat", "regex": "(?im)(?:et vous\\s*\\?|qu['’]en pensez-vous\\s*\\?|vous êtes d['’]accord\\s*\\?|d['’]accord avec moi\\s*\\?)\\s*$", "name": "Appel à l'engagement réflexe", "fix": "Posez une question que vous seule pouvez poser, sur ce qui précède."},
    {"id": "spoiler", "regex": "(?im)^\\s*(?:spoiler|petit spoiler|attention spoiler)\\s*:", "name": "« Spoiler : »", "fix": "Dites la chose, sans l'annoncer."}
  ]
}
