  "phrases": [
    {"find": "dans un monde en constante évolution", "replace": "aujourd'hui", "family": "ouvertures"},
    {"find": "dans un monde en perpétuelle évolution", "replace": "aujourd'hui", "family": "ouvertures"},
    {"find": "dans un monde en pleine mutation", "replace": "aujourd'hui", "family": "ouvertures"},
    {"find": "à l'ère du numérique", "replace": "aujourd'hui", "family": "ouvertures"},
